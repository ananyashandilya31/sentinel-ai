# SentinelAI Environment Variables Template
# Copy this file to .env and adjust values for your environment

# Environment: development | production | test
ENVIRONMENT=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://sentinel_user:sentinel_pass@localhost:5432/sentinel_db

# Security & Authentication
JWT_SECRET=supersecretkey_change_in_production_min_32_chars_123456
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Require a Bearer token on write endpoints (set false to run the demo without login)
AUTH_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# Bootstrap admin account (created on first boot / POST /api/v1/auth/seed).
# The values below are LOCAL DEVELOPMENT DEFAULTS — change them for any
# shared or deployed environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=admin@sentinel.local

# LLM Threat Intelligence & Explanation (Phase 6)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# External Threat Intelligence (Phase 5 - optional)
THREAT_INTEL_API_KEY=optional_virustotal_or_abuseipdb_key

# Frontend Host (for CORS)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
