# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv
venv/
backend/venv/

# Environment Variables
.env
.env.local
.env.*.local
# Local env copies — these must never be committed (real keys!)
.env.txt
.env.*.txt
# Any .env.* variant (e.g. frontend/.env.production) may hold real keys
.env.*
*.env
# …but the template must stay tracked
!.env.example

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
frontend/dist-ssr/
*.local

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Database & Storage
*.sqlite
*.sqlite3
*.db

# ML models / artifacts
# Ignored everywhere, not just ml/models/ — a model saved to any path
# must never be committed (binary, large, regenerable via train.py).
*.joblib
*.pkl
*.onnx
*.h5
ml/models/*
!ml/models/.gitkeep

# Logs & OS noise
*.log
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
