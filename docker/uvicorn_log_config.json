{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "safe": {
      "()": "backend.logging_config.SafeDefaultFormatter",
      "fmt": "%(levelprefix)s %(message)s",
      "use_colors": null
    },
    "access": {
      "()": "backend.logging_config.SafeAccessFormatter",
      "fmt": "%(client_addr)s - \"%(request_line)s\" %(status_code)s",
      "use_colors": null
    }
  },
  "handlers": {
    "default": {
      "class": "logging.StreamHandler",
      "formatter": "safe",
      "stream": "ext://sys.stderr"
    },
    "access": {
      "class": "logging.StreamHandler",
      "formatter": "access",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["default"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["default"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["access"],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["default"],
    "level": "INFO"
  }
}
